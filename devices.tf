locals {
  # Shared by the default profile and the onboarding custom profile below -
  # this is WARP's standard RFC1918 / link-local / broadcast exclude list.
  warp_default_excludes = [
    { address = "10.0.0.0/8" },
    { address = "100.64.0.0/10" },
    { address = "169.254.0.0/16", description = "DHCP Unspecified" },
    { address = "172.16.0.0/12" },
    { address = "192.0.0.0/24" },
    { address = "192.168.0.0/16" },
    { address = "224.0.0.0/24" },
    { address = "240.0.0.0/4" },
    { address = "255.255.255.255/32", description = "DHCP Broadcast" },
    { address = "fe80::/10", description = "IPv6 Link Local" },
    { address = "fd00::/8" },
    { address = "ff01::/16" },
    { address = "ff02::/16" },
    { address = "ff03::/16" },
    { address = "ff04::/16" },
    { address = "ff05::/16" },
  ]
}

resource "cloudflare_zero_trust_device_default_profile" "default" {
  account_id                     = var.cloudflare_account_id
  allow_mode_switch              = false
  allow_updates                  = false
  allowed_to_leave               = true
  auto_connect                   = 0
  captive_portal                 = 180
  disable_auto_fallback          = false
  exclude_office_ips             = false
  register_interface_ip_with_dns = true
  sccm_vpn_boundary_support      = false
  switch_locked                  = false
  dns_search_suffixes            = []
  exclude                        = local.warp_default_excludes
  service_mode_v2 = {
    mode = "warp"
  }
}

# Auto-generated by WARP onboarding on 2025-10-18 for the two Google-account users.
# NOTE: worth reviewing whether this per-user profile is still needed, or whether
# its settings should just live on the default profile above.
resource "cloudflare_zero_trust_device_custom_profile" "onboarding" {
  account_id                     = var.cloudflare_account_id
  name                           = "Onboarding Device profile: 10/18/2025"
  description                    = "Auto-generated device profile created by warp onboarding"
  match                          = "identity.email in {\"petr.nemec@gmx.com\" \"pnemec.posta@gmail.com\"}"
  precedence                     = 1000
  enabled                        = true
  allow_mode_switch              = false
  allow_updates                  = false
  allowed_to_leave               = true
  auto_connect                   = 0
  captive_portal                 = 180
  disable_auto_fallback          = false
  exclude_office_ips             = false
  register_interface_ip_with_dns = true
  sccm_vpn_boundary_support      = false
  switch_locked                  = false
  dns_search_suffixes            = []
  exclude                        = local.warp_default_excludes
  service_mode_v2 = {
    mode = "warp"
  }
}
